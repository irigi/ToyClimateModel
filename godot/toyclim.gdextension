[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.5
reloadable = true

[libraries]
linux.debug.x86_64 = "res://../target/debug/libtoyclim_godot.so"
linux.release.x86_64 = "res://../target/release/libtoyclim_godot.so"
windows.debug.x86_64 = "res://../target/debug/toyclim_godot.dll"
windows.release.x86_64 = "res://../target/release/toyclim_godot.dll"
macos.debug = "res://../target/debug/libtoyclim_godot.dylib"
macos.release = "res://../target/release/libtoyclim_godot.dylib"
