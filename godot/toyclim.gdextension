[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.3
reloadable = true

; ../run builds the extension and copies it to bin/ (debug or release, whichever was built),
; so the editor (a "debug" build) and exported release builds load the same file.
[libraries]
linux.debug.x86_64 = "res://bin/libtoyclim_godot.so"
linux.release.x86_64 = "res://bin/libtoyclim_godot.so"
